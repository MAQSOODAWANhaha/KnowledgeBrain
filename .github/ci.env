# Single source for CI toolchain, service ports, artifact names, and test lists.
# Image digests stay in deploy/images.lock.json. The Rust channel must match rust-toolchain.toml.
# Job timeout-minutes stay in .github/workflows/ci.yml: GitHub reads them before any step runs.
#
# Push events are limited to CI_PUSH_BRANCH. GitHub cannot read the default branch
# inside `on:`, so .github/workflows/ci.yml repeats that name and scripts/ci_check_sources.sh
# fails the run when the two disagree or the branch is not the repository default.
# pull_request is the only event for a PR commit, so each PR commit starts one run.
#
# Destructive acceptance scripts pin 127.0.0.1:$CI_POSTGRES_PORT on purpose. That pin
# is a fail-closed guard, not a second configuration. ci_check_sources.sh compares it
# to CI_POSTGRES_PORT.

RUST_TOOLCHAIN=1.97.0
RUST_COMPONENTS=rustfmt,clippy
PYTHON_VERSION=3.12
NODE_VERSION=22
# Shared dev-profile cache. Rotated off ci-dev: that key had been saved by an
# earlier commit and made the first green run of this head a cache hit.
RUST_CACHE_SHARED_KEY=ci-workspace
CI_PUSH_BRANCH=main
CI_ARTIFACT_RETENTION_DAYS=7

# ubuntu-latest still selects this image, and begins moving to Ubuntu 26 on
# 2026-10-19. Pinning 24.04 keeps the image the current jobs were written for.
# runs-on cannot read env. The workflow sets this once as YAML anchor `&runner`.
CI_RUNNER=ubuntu-24.04

# `uses:` cannot read env either. These are the current Node 24 majors.
# astral-sh/setup-uv stopped publishing floating major tags in v8.
# dtolnay/rust-toolchain is a composite action (no Node runtime); @master is the
# maintained ref. Its only version tag is the 2022 v1.
CI_ACTION_CHECKOUT=actions/checkout@v7
CI_ACTION_SETUP_NODE=actions/setup-node@v7
CI_ACTION_SETUP_PYTHON=actions/setup-python@v7
CI_ACTION_UPLOAD_ARTIFACT=actions/upload-artifact@v7
CI_ACTION_DOWNLOAD_ARTIFACT=actions/download-artifact@v8
CI_ACTION_DOCKER_LOGIN=docker/login-action@v4
CI_ACTION_DOCKER_BUILDX=docker/setup-buildx-action@v4
CI_ACTION_DOCKER_BUILD_PUSH=docker/build-push-action@v7
CI_ACTION_SETUP_UV=astral-sh/setup-uv@v10.2.0
CI_ACTION_RUST_TOOLCHAIN=dtolnay/rust-toolchain@master
CI_ACTION_RUST_CACHE=Swatinem/rust-cache@v2

CI_POSTGRES_HOST=127.0.0.1
CI_POSTGRES_PORT=25433
CI_REDIS_PORT=26379
# Shared by scripts/ci_services.sh: wait_ready until pg_isready, and createdb
# retries after that. The Postgres image accepts connections on a temporary
# postmaster during init, then closes them when it restarts.
CI_SERVICE_READY_ATTEMPTS=60
CI_SERVICE_READY_INTERVAL_SECONDS=1

CI_APP_POSTGRES_USER=postgres
CI_APP_POSTGRES_PASSWORD=postgres
CI_APP_POSTGRES_DB=knowledgebrain_test_ci

CI_SCHEMA_POSTGRES_USER=postgres
CI_SCHEMA_POSTGRES_PASSWORD=postgres
CI_SCHEMA_POSTGRES_DB=postgres
CI_FRESH_DATABASE=knowledgebrain_test_fresh_ci
CI_FRESH_TEST=fresh_database_postgres


CI_ARTIFACT_NAME=rust-ci-binaries
CI_BIN_DIR=ci-binaries

# Debug binaries rust-build compiles and later jobs execute.
CI_PLATFORM_PACKAGE=platform
CI_API_BIN=api
CI_WORKER_BIN=worker
CI_MIGRATOR_BIN=migrator

CI_KNOWLEDGE_WORKFLOW_TESTS="workflow_faults_postgres clone_initialization_postgres review_generation_visibility"
CI_OXANA_TEST=oxana_native_faults

# Pytest paths are relative to services/docreader; workflow tests use isolated PostgreSQL.
CI_DOCREADER_PYTEST_PATHS=tests/
