# Single source for CI toolchain, service ports, and artifact names.
# Image digests stay in deploy/images.lock.json. The Rust channel must match rust-toolchain.toml.
# Job timeout-minutes stay in .github/workflows/ci.yml: GitHub reads them before any step runs.

RUST_TOOLCHAIN=1.97.0
RUST_COMPONENTS=rustfmt,clippy
PYTHON_VERSION=3.12
NODE_VERSION=22
RUST_CACHE_SHARED_KEY=ci-dev

CI_POSTGRES_HOST=127.0.0.1
CI_POSTGRES_PORT=25433
CI_REDIS_PORT=26379
CI_SERVICE_READY_ATTEMPTS=60
CI_SERVICE_READY_INTERVAL_SECONDS=1

CI_APP_POSTGRES_USER=postgres
CI_APP_POSTGRES_PASSWORD=postgres
CI_APP_POSTGRES_DB=knowledgebrain_test_ci
CI_FROZEN_DATABASE=knowledgebrain_test_frozen_replay_ci

CI_SCHEMA_POSTGRES_USER=knowledgebrain
CI_SCHEMA_POSTGRES_PASSWORD=postgres
CI_SCHEMA_POSTGRES_DB=postgres
CI_SCHEMA_LIFECYCLE_DATABASE=knowledgebrain_test_lifecycle_ci
CI_SCHEMA_CATALOG_DATABASE=knowledgebrain_test_catalog_ci

KNOWLEDGEBRAIN_MIGRATOR_PASSWORD=migrator
KNOWLEDGEBRAIN_API_DB_PASSWORD=api
KNOWLEDGEBRAIN_WORKER_DB_PASSWORD=worker
KNOWLEDGEBRAIN_RETENTION_DB_PASSWORD=retention

CI_CONTENT_NAMESPACE_ID=8fa19c5f-2afb-4cd8-b1c9-3378bcfd41a3
CI_ARTIFACT_NAME=rust-ci-binaries
CI_BIN_DIR=ci-binaries

# Empty features change only cfg gates. One build produces both contract test binaries.
CI_CONTRACT_FEATURES=knowledge-v2-exact-contract-tests,docreader-contract-tests
CI_DEFAULT_BIDDING_TESTS="content_agent_run_postgres request_delivery_postgres tender_analysis_postgres"
CI_DEFAULT_PLATFORM_TESTS="catalog_manifest_postgres oxana_native_faults"
CI_FEATURE_BIDDING_TESTS="knowledge_retrieval_exact_v2 tender_document_process_real_parse_counts"

ONE_SHOT_TEST=outline::acceptance::one_shot_acceptance_publishes_from_the_tool_draft
RETIREMENT_TEST_PREFIX=analysis::agent::retirement::
CI_FROZEN_EXACT_TEST=frozen_exact_replay_and_attestation_survive_current_version_and_latest_policy_changes
