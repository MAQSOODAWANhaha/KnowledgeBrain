{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledgebrain:bid:content-generation-input:v1",
  "title": "ContentGenerationInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_artifact_id",
    "project_id",
    "workspace_id",
    "workspace_scope",
    "base_workspace_revision_id",
    "base_workspace_sha256",
    "requirement_projection_revision_id",
    "target",
    "fill_policy",
    "selection_mode",
    "evidence_selection_input",
    "requirements",
    "evidence_bundle_ids",
    "current_block_revision_ids",
    "document_settings_revision_id",
    "prompt_contract_id",
    "prompt_contract_sha256",
    "template_contract_id",
    "template_contract_sha256",
    "model_contract_id",
    "model_contract_sha256",
    "agent_contract_id",
    "agent_contract_sha256",
    "input_sha256",
    "workspace_scope_revision_id",
    "workspace_scope_sha256",
    "outline_checkpoint_id",
    "outline_checkpoint_sha256",
    "requirement_projection_sha256",
    "evidence_selection_sha256",
    "document_settings_sha256",
    "render_style_contract_id",
    "render_style_contract_sha256",
    "quote_snapshot"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_artifact_id": {
      "$ref": "#/$defs/uuid"
    },
    "project_id": {
      "$ref": "#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "#/$defs/uuid"
    },
    "workspace_scope": {
      "const": "project_wide"
    },
    "base_workspace_revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "base_workspace_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requirement_projection_revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "fill_policy": {
      "enum": [
        "empty_only",
        "append_candidate",
        "missing_requirements_only"
      ]
    },
    "insertion_anchor": {
      "anyOf": [
        {
          "$ref": "#/$defs/insertionAnchor"
        },
        {
          "type": "null"
        }
      ]
    },
    "selection_mode": {
      "enum": [
        "system_proposed",
        "user_pick_set"
      ]
    },
    "evidence_selection_input": {
      "oneOf": [
        {
          "$ref": "#/$defs/systemSelection"
        },
        {
          "$ref": "#/$defs/userSelection"
        }
      ]
    },
    "requirements": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "evidence_bundle_ids": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "current_block_revision_ids": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "document_settings_revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "prompt_contract_id": {
      "$ref": "#/$defs/uuid"
    },
    "prompt_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "template_contract_id": {
      "$ref": "#/$defs/uuid"
    },
    "template_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_contract_id": {
      "$ref": "#/$defs/uuid"
    },
    "model_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "agent_contract_id": {
      "$ref": "#/$defs/uuid"
    },
    "agent_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "workspace_scope_revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "workspace_scope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "outline_checkpoint_id": {
      "$ref": "#/$defs/uuid"
    },
    "outline_checkpoint_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requirement_projection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_selection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "document_settings_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "render_style_contract_id": {
      "$ref": "#/$defs/uuid"
    },
    "render_style_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "quote_snapshot": {
      "oneOf": [
        {
          "$ref": "#/$defs/frozenIdentity"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "node_lineage_id",
            "node_revision_id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "node",
                "subtree"
              ]
            },
            "node_lineage_id": {
              "$ref": "#/$defs/uuid"
            },
            "node_revision_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "workspace_revision_id"
          ],
          "properties": {
            "kind": {
              "const": "workspace"
            },
            "workspace_revision_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      ]
    },
    "insertionAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_revision_id"
      ],
      "properties": {
        "node_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "block_revision_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "utf8_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "systemSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "matching_policy_id",
        "matching_policy_sha256"
      ],
      "properties": {
        "kind": {
          "const": "system_proposed"
        },
        "matching_policy_id": {
          "$ref": "#/$defs/uuid"
        },
        "matching_policy_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "userSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pick_set_artifact_id",
        "pick_set_sha256"
      ],
      "properties": {
        "kind": {
          "const": "user_pick_set"
        },
        "pick_set_artifact_id": {
          "$ref": "#/$defs/uuid"
        },
        "pick_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_revision_id",
        "need_occurrence_ids",
        "text",
        "requiredness",
        "compliance_policy",
        "lifecycle"
      ],
      "properties": {
        "requirement_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "need_occurrence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "requiredness": {
          "enum": [
            "mandatory",
            "optional",
            "informational"
          ]
        },
        "compliance_policy": {
          "enum": [
            "must_comply",
            "explicit_response",
            "deviation_allowed",
            "scored"
          ]
        },
        "lifecycle": {
          "enum": [
            "current",
            "superseded",
            "withdrawn",
            "unresolved"
          ]
        }
      }
    },
    "frozenIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/uuid"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selection_mode": {
            "const": "system_proposed"
          }
        },
        "required": [
          "selection_mode"
        ]
      },
      "then": {
        "properties": {
          "evidence_selection_input": {
            "$ref": "#/$defs/systemSelection"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selection_mode": {
            "const": "user_pick_set"
          }
        },
        "required": [
          "selection_mode"
        ]
      },
      "then": {
        "properties": {
          "evidence_selection_input": {
            "$ref": "#/$defs/userSelection"
          }
        }
      }
    }
  ]
}
