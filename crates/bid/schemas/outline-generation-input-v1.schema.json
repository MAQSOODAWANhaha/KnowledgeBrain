{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledgebrain:bid:outline-generation-input:v1",
  "title": "OutlineGenerationInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_artifact_id",
    "project_id",
    "workspace_id",
    "workspace_scope",
    "workspace_scope_revision_id",
    "workspace_scope_sha256",
    "document_set_revision_id",
    "document_set_sha256",
    "disposition_set_revision_id",
    "disposition_set_sha256",
    "requirement_projection_revision_id",
    "requirement_projection_sha256",
    "source_units",
    "requirements",
    "structured_forms",
    "prompt_contract_id",
    "prompt_contract_sha256",
    "template_contract_id",
    "template_contract_sha256",
    "model_contract_id",
    "model_contract_sha256",
    "agent_contract_id",
    "agent_contract_sha256",
    "input_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_artifact_id": {
      "$ref": "#/$defs/uuid"
    },
    "project_id": {
      "$ref": "#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "#/$defs/uuid"
    },
    "workspace_scope": {
      "const": "project_wide"
    },
    "document_set_revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "document_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "disposition_set_revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "disposition_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requirement_projection_revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "requirement_projection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_units": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/sourceUnit"
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "structured_forms": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/form"
      }
    },
    "prompt_contract_id": {
      "$ref": "#/$defs/uuid"
    },
    "prompt_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "template_contract_id": {
      "$ref": "#/$defs/uuid"
    },
    "template_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_contract_id": {
      "$ref": "#/$defs/uuid"
    },
    "model_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "agent_contract_id": {
      "$ref": "#/$defs/uuid"
    },
    "agent_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "workspace_scope_revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "workspace_scope_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_unit_revision_id",
        "kind",
        "text",
        "source_span_sha256",
        "disposition"
      ],
      "properties": {
        "source_unit_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "section",
            "table_row",
            "form_region",
            "attachment_region",
            "image_ocr_region"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 1048576
        },
        "source_span_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "disposition": {
          "enum": [
            "requirement",
            "non_requirement",
            "unresolved"
          ]
        }
      }
    },
    "fulfillmentNeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "need_occurrence_id",
        "channel",
        "requiredness",
        "compliance_policy",
        "lifecycle"
      ],
      "properties": {
        "need_occurrence_id": {
          "$ref": "#/$defs/uuid"
        },
        "channel": {
          "enum": [
            "narrative_content",
            "response_table",
            "deviation_statement",
            "structured_form",
            "evidence_attachment",
            "quotation"
          ]
        },
        "requiredness": {
          "enum": [
            "mandatory",
            "optional",
            "informational"
          ]
        },
        "compliance_policy": {
          "enum": [
            "must_comply",
            "explicit_response",
            "deviation_allowed",
            "scored"
          ]
        },
        "lifecycle": {
          "enum": [
            "current",
            "superseded",
            "withdrawn",
            "unresolved"
          ]
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_revision_id",
        "text",
        "kind",
        "source_unit_revision_ids",
        "fulfillment_needs",
        "requiredness",
        "compliance_policy",
        "lifecycle"
      ],
      "properties": {
        "requirement_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "kind": {
          "enum": [
            "qualification",
            "technical",
            "commercial",
            "pricing",
            "delivery",
            "evaluation",
            "format",
            "attachment",
            "other"
          ]
        },
        "source_unit_revision_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "fulfillment_needs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fulfillmentNeed"
          }
        },
        "requiredness": {
          "enum": [
            "mandatory",
            "optional",
            "informational"
          ]
        },
        "compliance_policy": {
          "enum": [
            "must_comply",
            "explicit_response",
            "deviation_allowed",
            "scored"
          ]
        },
        "lifecycle": {
          "enum": [
            "current",
            "superseded",
            "withdrawn",
            "unresolved"
          ]
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_definition_revision_id",
        "source_unit_revision_id",
        "title",
        "definition_sha256"
      ],
      "properties": {
        "form_definition_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_unit_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string",
          "maxLength": 1024
        },
        "definition_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
