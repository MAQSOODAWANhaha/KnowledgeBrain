{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledgebrain.local/schemas/outline-synthesis-packet-v5.schema.json",
  "title": "OutlineSynthesisPacketV5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_artifact_id",
    "frozen_input_sha256",
    "reduce_plan_sha256",
    "map_evidence_set_sha256",
    "grouping_evidence_set_sha256",
    "composition_spine",
    "section_obligation_matrix",
    "fulfillment_groups",
    "non_output_fragments",
    "deterministic_spine_nodes",
    "manifest",
    "selected_evidence",
    "selected_facts",
    "draft"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "request_artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "frozen_input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reduce_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "map_evidence_set_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "grouping_evidence_set_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "composition_spine": {
      "$ref": "urn:knowledgebrain:bid:composition-spine:v1"
    },
    "section_obligation_matrix": {
      "$ref": "https://knowledgebrain.local/schemas/section-obligation-matrix-v2.schema.json"
    },
    "fulfillment_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "https://knowledgebrain.local/schemas/fulfillment-group-v1.schema.json"
      }
    },
    "deterministic_spine_nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "selected_evidence": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "selected_facts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_sha256",
        "nodes",
        "patch_receipts",
        "closure_facts"
      ],
      "properties": {
        "draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nodes": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/draftNode"
          }
        },
        "patch_receipts": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/patchReceipt"
          }
        },
        "closure_facts": {
          "$ref": "#/$defs/closureFacts"
        }
      }
    },
    "non_output_fragments": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "outline_usage",
          "source_unit_revision_ids"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "outline_usage": {
            "enum": [
              "requirement_context",
              "reference_only"
            ]
          },
          "source_unit_revision_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "need_occurrence_id",
        "channel",
        "requiredness"
      ],
      "properties": {
        "need_occurrence_id": {
          "$ref": "#/$defs/uuid"
        },
        "channel": {
          "enum": [
            "narrative_content",
            "response_table",
            "deviation_statement",
            "structured_form",
            "evidence_attachment",
            "quotation"
          ]
        },
        "requiredness": {
          "enum": [
            "mandatory",
            "optional",
            "informational"
          ]
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_unit_revision_ids",
        "requirement_occurrences",
        "structured_form_revision_ids",
        "batch_count"
      ],
      "properties": {
        "source_unit_revision_ids": {
          "type": "array",
          "maxItems": 1000000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "requirement_occurrences": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/need"
          }
        },
        "structured_form_revision_ids": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "batch_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_ref",
        "title",
        "semantic_role",
        "outline_usage",
        "applicability",
        "composition_parent_role",
        "path_segments",
        "heading_level",
        "source_numbering",
        "source_order",
        "source_unit_revision_ids",
        "confidence"
      ],
      "properties": {
        "signal_ref": {
          "$ref": "#/$defs/sha256"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "semantic_role": {
          "enum": [
            "cover",
            "toc",
            "qualification",
            "technical",
            "commercial",
            "quotation",
            "deviation",
            "implementation",
            "evidence_index",
            "attachment",
            "other"
          ]
        },
        "outline_usage": {
          "enum": [
            "composition_spine",
            "output_child",
            "form_template",
            "requirement_context",
            "reference_only"
          ]
        },
        "applicability": {
          "enum": [
            "required",
            "optional",
            "conditional",
            "not_applicable"
          ]
        },
        "composition_parent_role": {
          "anyOf": [
            {
              "enum": [
                "cover",
                "toc",
                "qualification",
                "technical",
                "commercial",
                "quotation",
                "deviation",
                "implementation",
                "evidence_index",
                "attachment",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "path_segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "heading_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "source_numbering": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "source_order": {
          "type": "integer",
          "minimum": 0
        },
        "source_unit_revision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_unit_revision_id",
        "offset",
        "length",
        "result_sha256"
      ],
      "properties": {
        "source_unit_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "source_unit_revision_ids"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_unit_revision_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "packetNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "source_identity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "source_unit_revision_ids"
      ],
      "properties": {
        "fact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "source_unit_revision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_node_ref",
        "parent_client_node_ref",
        "ordinal",
        "title",
        "semantic_role",
        "render_role",
        "origin_source_unit_revision_ids"
      ],
      "properties": {
        "client_node_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "parent_client_node_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "semantic_role": {
          "enum": [
            "cover",
            "toc",
            "qualification",
            "technical",
            "commercial",
            "quotation",
            "deviation",
            "implementation",
            "evidence_index",
            "attachment",
            "other"
          ]
        },
        "render_role": {
          "enum": [
            "section",
            "front_matter",
            "toc",
            "appendix",
            "hidden"
          ]
        },
        "origin_source_unit_revision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "draftNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_node_ref",
        "parent_client_node_ref",
        "ordinal",
        "title",
        "semantic_role",
        "render_role",
        "origin_source_unit_revision_ids",
        "coverage_group_refs"
      ],
      "properties": {
        "client_node_ref": {
          "$ref": "#/$defs/clientRef"
        },
        "parent_client_node_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/clientRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "semantic_role": {
          "enum": [
            "cover",
            "toc",
            "qualification",
            "technical",
            "commercial",
            "quotation",
            "deviation",
            "implementation",
            "evidence_index",
            "attachment",
            "other"
          ]
        },
        "render_role": {
          "enum": [
            "section",
            "front_matter",
            "toc",
            "appendix",
            "hidden"
          ]
        },
        "origin_source_unit_revision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "coverage_group_refs": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "invalidAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "identity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "patchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch_ref",
        "patch_sha256",
        "base_draft_sha256",
        "result_draft_sha256",
        "accepted"
      ],
      "properties": {
        "patch_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "patch_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "base_draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result_draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "closureFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_groups_total",
        "required_groups_assigned",
        "missing_group_refs",
        "empty_section_refs",
        "invalid_assignments",
        "draft_sha256"
      ],
      "properties": {
        "required_groups_total": {
          "type": "integer",
          "minimum": 0
        },
        "required_groups_assigned": {
          "type": "integer",
          "minimum": 0
        },
        "missing_group_refs": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "invalid_assignments": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/invalidAssignment"
          }
        },
        "draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "empty_section_refs": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
