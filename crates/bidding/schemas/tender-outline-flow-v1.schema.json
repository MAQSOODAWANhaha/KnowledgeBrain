  {
    "type": "function",
    "function": {
      "name": "read_outline_fragment",
      "description": "Read a saved fragment in bounded UTF-8 byte ranges. During check only the active packet is allowed. Confirm all ranges in a later model turn before submitting the check.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fragment_id",
          "start",
          "max_bytes"
        ],
        "properties": {
          "fragment_id": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
