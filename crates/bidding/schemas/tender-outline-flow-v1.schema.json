        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "description": "Confirmed inspected UTF-8 byte ranges with start < end. Reuse scan_ranges.text; never submit [0,0) for an empty source."
          },
          "forms": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
