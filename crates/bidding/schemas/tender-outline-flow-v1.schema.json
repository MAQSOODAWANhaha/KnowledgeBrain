      "name": "assign_outline_fragments",
      "description": "After organization, assign unresolved discovery fragment scopes to existing root chapter IDs or explicitly mark global clauses. Do not put unrelated technical clauses into composition.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
