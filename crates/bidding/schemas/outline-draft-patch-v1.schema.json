{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledgebrain.local/schemas/outline-draft-patch-v1.schema.json",
  "title": "OutlineDraftPatchV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_ref",
    "base_draft_sha256",
    "add_nodes",
    "replace_nodes",
    "delete_node_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "patch_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "base_draft_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "add_nodes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/draftNode"
      }
    },
    "replace_nodes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client_node_ref",
          "replacement"
        ],
        "properties": {
          "client_node_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "replacement": {
            "$ref": "#/$defs/draftNode"
          }
        }
      }
    },
    "delete_node_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "clientRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_node_ref",
        "parent_client_node_ref",
        "ordinal",
        "title",
        "semantic_role",
        "render_role",
        "origin_source_unit_revision_ids"
      ],
      "properties": {
        "client_node_ref": {
          "$ref": "#/$defs/clientRef"
        },
        "parent_client_node_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/clientRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "semantic_role": {
          "enum": [
            "cover",
            "toc",
            "qualification",
            "technical",
            "commercial",
            "quotation",
            "deviation",
            "implementation",
            "evidence_index",
            "attachment",
            "other"
          ]
        },
        "render_role": {
          "enum": [
            "section",
            "front_matter",
            "toc",
            "appendix",
            "hidden"
          ]
        },
        "origin_source_unit_revision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "need_occurrence_id",
        "channel",
        "target_client_node_ref"
      ],
      "properties": {
        "need_occurrence_id": {
          "$ref": "#/$defs/uuid"
        },
        "channel": {
          "enum": [
            "narrative_content",
            "response_table",
            "deviation_statement",
            "structured_form",
            "evidence_attachment",
            "quotation"
          ]
        },
        "target_client_node_ref": {
          "$ref": "#/$defs/clientRef"
        }
      }
    },
    "sectionObligationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "target_client_node_ref"
      ],
      "properties": {
        "obligation_id": {
          "$ref": "#/$defs/sha256"
        },
        "target_client_node_ref": {
          "$ref": "#/$defs/clientRef"
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "source_identity"
      ],
      "properties": {
        "code": {
          "enum": [
            "UNMAPPED_REQUIREMENT",
            "CONFLICTING_STRUCTURE",
            "LOW_CONFIDENCE",
            "UNRESOLVED_SOURCE",
            "FORM_STRUCTURE_DEVIATION",
            "EXCLUDED_NOT_APPLICABLE"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "high"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "draftNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_node_ref",
        "parent_client_node_ref",
        "ordinal",
        "title",
        "semantic_role",
        "render_role",
        "origin_source_unit_revision_ids",
        "coverage_group_refs"
      ],
      "properties": {
        "client_node_ref": {
          "$ref": "#/$defs/clientRef"
        },
        "parent_client_node_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/clientRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "semantic_role": {
          "enum": [
            "cover",
            "toc",
            "qualification",
            "technical",
            "commercial",
            "quotation",
            "deviation",
            "implementation",
            "evidence_index",
            "attachment",
            "other"
          ]
        },
        "render_role": {
          "enum": [
            "section",
            "front_matter",
            "toc",
            "appendix",
            "hidden"
          ]
        },
        "origin_source_unit_revision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "coverage_group_refs": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
