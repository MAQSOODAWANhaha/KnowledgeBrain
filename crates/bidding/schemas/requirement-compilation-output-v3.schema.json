{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledgebrain:bid:requirement-compilation-output:v3",
  "title": "RequirementCompilationOutputV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_unit_revision_ids", "requirements", "notices"],
  "properties": {
    "schema_version": { "const": 3 },
    "source_unit_revision_ids": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
    "requirements": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/requirement" } },
    "notices": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/notice" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "channel": { "enum": ["narrative_content", "response_table", "deviation_statement", "structured_form", "evidence_attachment", "quotation"] },
    "requirementKind": { "enum": ["qualification", "technical", "commercial", "pricing", "delivery", "evaluation", "format", "attachment", "other"] },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "source_unit_revision_ids"],
      "properties": {
        "status": { "enum": ["required", "optional", "conditional", "not_applicable"] },
        "reason": { "type": ["string", "null"], "maxLength": 1024 },
        "source_unit_revision_ids": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ref", "requirement_kind", "requiredness", "compliance_policy", "requirement_text", "channel", "applicability", "source_unit_revision_ids", "structured_form_revision_ids"],
      "properties": {
        "requirement_ref": { "$ref": "#/$defs/sha256" },
        "requirement_kind": { "$ref": "#/$defs/requirementKind" },
        "requiredness": { "enum": ["mandatory", "optional", "informational"] },
        "compliance_policy": { "enum": ["must_comply", "explicit_response", "deviation_allowed", "scored"] },
        "requirement_text": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "channel": { "$ref": "#/$defs/channel" },
        "applicability": { "$ref": "#/$defs/applicability" },
        "source_unit_revision_ids": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "structured_form_revision_ids": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "source_unit_revision_ids"],
      "properties": {
        "code": { "enum": ["LOW_CONFIDENCE", "UNRESOLVED_ATOMICITY", "FORM_CLASSIFICATION_CONFLICT", "APPLICABILITY_CONFLICT"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_unit_revision_ids": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    }
  }
}
