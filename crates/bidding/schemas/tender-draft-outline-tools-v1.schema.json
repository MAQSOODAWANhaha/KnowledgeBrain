[
  {
    "type": "function",
    "function": {
      "name": "put_outline_items",
      "description": "Atomically organize chapters after discovery. Parent IDs may reference an earlier item in this batch. All nodes require exact grounds; response nodes reference saved requirement IDs.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "remove_ids"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "parent",
                "order",
                "title",
                "prescribed",
                "grounds",
                "requirement_ids",
                "purpose",
                "format_refs"
              ],
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "parent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "order": {
                  "type": "integer",
                  "minimum": 0
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "prescribed": {
                  "type": "boolean"
                },
                "grounds": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object"
                  }
                },
                "requirement_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "purpose": {
                  "type": "string",
                  "enum": [
                    "group",
                    "response"
                  ]
                },
                "format_refs": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "remove_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
]
