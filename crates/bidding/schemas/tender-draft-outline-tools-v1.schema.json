[
  {
    "type": "function",
    "function": {
      "name": "put_outline_item",
      "description": "Add or replace one outline chapter. Empty id allocates. Use titles from the frozen source. Set parent to a volume id for composition items. Do not combine several listed items into one title.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parent", "order", "title", "prescribed", "grounds"],
        "properties": {
          "id": { "type": ["string", "null"] },
          "parent": { "type": ["string", "null"] },
          "order": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "prescribed": { "type": "boolean" },
          "grounds": { "type": "array", "minItems": 1, "items": { "type": "object" } }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "omit_outline_item",
      "description": "Omit a chapter with frozen grounds. Do not guess pages.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "reason", "grounds"],
        "properties": {
          "id": { "type": ["string", "null"] },
          "title": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "enum": ["bind_failed", "not_applicable", "parse_failed"] },
          "grounds": { "type": "array", "minItems": 1, "items": { "type": "object" } }
        }
      }
    }
  }
]
