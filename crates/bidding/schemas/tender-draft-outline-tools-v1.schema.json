[
  {
    "type": "function",
    "function": {
      "name": "put_outline_items",
      "description": "Atomically organize actual submission materials. Provide structure and requirement IDs only; the host derives exact evidence. Independent prescribed forms need separately locatable response nodes; constraints attach to their actual response material.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "remove_ids"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "parent",
                "order",
                "title",
                "prescribed",
                "requirement_ids",
                "purpose"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Use a tmp- prefixed ID for new nodes; updates require an existing stable chapter ID returned by id_map."
                },
                "parent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "order": {
                  "type": "integer",
                  "minimum": 0
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "prescribed": {
                  "type": "boolean"
                },
                "requirement_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "purpose": {
                  "type": "string",
                  "enum": [
                    "group",
                    "response"
                  ]
                }
              }
            }
          },
          "remove_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
]
