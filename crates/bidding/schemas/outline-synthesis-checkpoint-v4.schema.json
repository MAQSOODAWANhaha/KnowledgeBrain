{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledgebrain.local/schemas/outline-synthesis-checkpoint-v4.schema.json",
  "title": "OutlineSynthesisCheckpointV4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt",
    "phase",
    "reduce_plan_sha256",
    "selected_evidence",
    "selected_facts",
    "nodes",
    "patch_receipts",
    "closure_facts",
    "total_turns",
    "total_tool_calls",
    "text_bytes_read",
    "images_read"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "collecting",
        "drafting",
        "verifying",
        "repairing"
      ]
    },
    "reduce_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selected_evidence": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "selected_facts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/draftNode"
      }
    },
    "patch_receipts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/patchReceipt"
      }
    },
    "closure_facts": {
      "$ref": "#/$defs/closureFacts"
    },
    "total_turns": {
      "type": "integer",
      "minimum": 0
    },
    "total_tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "text_bytes_read": {
      "type": "integer",
      "minimum": 0
    },
    "images_read": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "clientRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_unit_revision_id",
        "offset",
        "length",
        "result_sha256"
      ],
      "properties": {
        "source_unit_revision_id": {
          "$ref": "#/$defs/uuid"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "source_unit_revision_ids"
      ],
      "properties": {
        "fact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "source_unit_revision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_node_ref",
        "parent_client_node_ref",
        "ordinal",
        "title",
        "semantic_role",
        "render_role",
        "origin_source_unit_revision_ids"
      ],
      "properties": {
        "client_node_ref": {
          "$ref": "#/$defs/clientRef"
        },
        "parent_client_node_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/clientRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "semantic_role": {
          "enum": [
            "cover",
            "toc",
            "qualification",
            "technical",
            "commercial",
            "quotation",
            "deviation",
            "implementation",
            "evidence_index",
            "attachment",
            "other"
          ]
        },
        "render_role": {
          "enum": [
            "section",
            "front_matter",
            "toc",
            "appendix",
            "hidden"
          ]
        },
        "origin_source_unit_revision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "draftNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_node_ref",
        "parent_client_node_ref",
        "ordinal",
        "title",
        "semantic_role",
        "render_role",
        "origin_source_unit_revision_ids",
        "coverage_group_refs"
      ],
      "properties": {
        "client_node_ref": {
          "$ref": "#/$defs/clientRef"
        },
        "parent_client_node_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/clientRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "semantic_role": {
          "enum": [
            "cover",
            "toc",
            "qualification",
            "technical",
            "commercial",
            "quotation",
            "deviation",
            "implementation",
            "evidence_index",
            "attachment",
            "other"
          ]
        },
        "render_role": {
          "enum": [
            "section",
            "front_matter",
            "toc",
            "appendix",
            "hidden"
          ]
        },
        "origin_source_unit_revision_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "coverage_group_refs": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "invalidAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "identity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "patchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch_ref",
        "patch_sha256",
        "base_draft_sha256",
        "result_draft_sha256",
        "accepted"
      ],
      "properties": {
        "patch_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "patch_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "base_draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result_draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "closureFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_groups_total",
        "required_groups_assigned",
        "missing_group_refs",
        "empty_section_refs",
        "invalid_assignments",
        "draft_sha256"
      ],
      "properties": {
        "required_groups_total": {
          "type": "integer",
          "minimum": 0
        },
        "required_groups_assigned": {
          "type": "integer",
          "minimum": 0
        },
        "missing_group_refs": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "invalid_assignments": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/invalidAssignment"
          }
        },
        "draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "empty_section_refs": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
