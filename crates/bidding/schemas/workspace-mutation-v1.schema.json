{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledgebrain:bid:workspace-mutation:v1",
  "title": "WorkspaceMutationRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "expected_workspace_revision_id",
    "expected_workspace_sha256",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workspace_id": {
      "$ref": "#/$defs/uuid"
    },
    "expected_workspace_revision_id": {
      "$ref": "#/$defs/uuid"
    },
    "expected_workspace_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "documentSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_size",
        "margins_mm",
        "body_font_pt",
        "line_spacing",
        "heading_numbering",
        "header",
        "footer",
        "page_number"
      ],
      "properties": {
        "page_size": {
          "const": "A4"
        },
        "margins_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "properties": {
            "top": {
              "type": "number",
              "minimum": 5,
              "maximum": 80
            },
            "right": {
              "type": "number",
              "minimum": 5,
              "maximum": 80
            },
            "bottom": {
              "type": "number",
              "minimum": 5,
              "maximum": 80
            },
            "left": {
              "type": "number",
              "minimum": 5,
              "maximum": 80
            }
          }
        },
        "body_font_pt": {
          "type": "number",
          "minimum": 6,
          "maximum": 48
        },
        "line_spacing": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 4
        },
        "heading_numbering": {
          "enum": [
            "decimal",
            "chinese",
            "none"
          ]
        },
        "header": {
          "type": "string",
          "maxLength": 2048
        },
        "footer": {
          "type": "string",
          "maxLength": 2048
        },
        "page_number": {
          "enum": [
            "none",
            "footer_center",
            "footer_outside"
          ]
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "client_node_ref",
            "parent_lineage_id",
            "ordinal",
            "title",
            "semantic_role",
            "render_role"
          ],
          "properties": {
            "kind": {
              "const": "insert_node"
            },
            "client_node_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "parent_lineage_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0
            },
            "title": {
              "$ref": "#/$defs/title"
            },
            "semantic_role": {
              "enum": [
                "cover",
                "toc",
                "qualification",
                "technical",
                "commercial",
                "quotation",
                "deviation",
                "implementation",
                "evidence_index",
                "attachment",
                "other"
              ]
            },
            "render_role": {
              "enum": [
                "section",
                "front_matter",
                "toc",
                "appendix",
                "hidden"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "node_lineage_id",
            "title"
          ],
          "properties": {
            "kind": {
              "const": "rename_node"
            },
            "node_lineage_id": {
              "$ref": "#/$defs/uuid"
            },
            "title": {
              "$ref": "#/$defs/title"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "node_lineage_id",
            "parent_lineage_id",
            "ordinal"
          ],
          "properties": {
            "kind": {
              "const": "move_node"
            },
            "node_lineage_id": {
              "$ref": "#/$defs/uuid"
            },
            "parent_lineage_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "node_lineage_id",
            "titles"
          ],
          "properties": {
            "kind": {
              "const": "split_node"
            },
            "node_lineage_id": {
              "$ref": "#/$defs/uuid"
            },
            "titles": {
              "type": "array",
              "minItems": 2,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/title"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "node_lineage_ids",
            "title"
          ],
          "properties": {
            "kind": {
              "const": "merge_nodes"
            },
            "node_lineage_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/uuid"
              }
            },
            "title": {
              "$ref": "#/$defs/title"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "node_lineage_id"
          ],
          "properties": {
            "kind": {
              "const": "delete_node"
            },
            "node_lineage_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "node_lineage_id",
            "ordinal",
            "block"
          ],
          "properties": {
            "kind": {
              "const": "insert_block"
            },
            "node_lineage_id": {
              "$ref": "#/$defs/uuid"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0
            },
            "block": {
              "$ref": "urn:knowledgebrain:bid:content-block:v1"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "block_lineage_id",
            "block"
          ],
          "properties": {
            "kind": {
              "const": "update_block"
            },
            "block_lineage_id": {
              "$ref": "#/$defs/uuid"
            },
            "block": {
              "$ref": "urn:knowledgebrain:bid:content-block:v1"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "block_lineage_id",
            "target_node_lineage_id",
            "ordinal"
          ],
          "properties": {
            "kind": {
              "const": "move_block"
            },
            "block_lineage_id": {
              "$ref": "#/$defs/uuid"
            },
            "target_node_lineage_id": {
              "$ref": "#/$defs/uuid"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "block_lineage_id"
          ],
          "properties": {
            "kind": {
              "const": "delete_block"
            },
            "block_lineage_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "node_lineage_id",
            "asset_revision_id",
            "ordinal"
          ],
          "properties": {
            "kind": {
              "const": "insert_asset_block"
            },
            "node_lineage_id": {
              "$ref": "#/$defs/uuid"
            },
            "asset_revision_id": {
              "$ref": "#/$defs/uuid"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "settings"
          ],
          "properties": {
            "kind": {
              "const": "update_document_settings"
            },
            "settings": {
              "$ref": "#/$defs/documentSettings"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "need_occurrence_id",
            "channel",
            "requirement_projection_revision_id",
            "requirement_projection_sha256",
            "target",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "bind_fulfillment"
            },
            "need_occurrence_id": {
              "$ref": "#/$defs/uuid"
            },
            "channel": {
              "enum": [
                "narrative_content",
                "response_table",
                "deviation_statement",
                "structured_form",
                "evidence_attachment",
                "quotation"
              ]
            },
            "requirement_projection_revision_id": {
              "$ref": "#/$defs/uuid"
            },
            "requirement_projection_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "target": {
              "$ref": "#/$defs/bindingTarget"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "binding_lineage_id",
            "need_occurrence_id",
            "channel",
            "requirement_projection_revision_id",
            "requirement_projection_sha256",
            "target",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "remap_fulfillment"
            },
            "binding_lineage_id": {
              "$ref": "#/$defs/uuid"
            },
            "need_occurrence_id": {
              "$ref": "#/$defs/uuid"
            },
            "channel": {
              "enum": [
                "narrative_content",
                "response_table",
                "deviation_statement",
                "structured_form",
                "evidence_attachment",
                "quotation"
              ]
            },
            "requirement_projection_revision_id": {
              "$ref": "#/$defs/uuid"
            },
            "requirement_projection_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "target": {
              "$ref": "#/$defs/bindingTarget"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "binding_lineage_id"
          ],
          "properties": {
            "kind": {
              "const": "unbind_fulfillment"
            },
            "binding_lineage_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      ]
    },
    "bindingTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "node_lineage_id"
          ],
          "properties": {
            "kind": {
              "const": "outline_node"
            },
            "node_lineage_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "block_lineage_id"
          ],
          "properties": {
            "kind": {
              "const": "response_table"
            },
            "block_lineage_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "form_definition_revision_id"
          ],
          "properties": {
            "kind": {
              "const": "structured_form"
            },
            "form_definition_revision_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "quote_snapshot_id"
          ],
          "properties": {
            "kind": {
              "const": "quote"
            },
            "quote_snapshot_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      ]
    }
  }
}
