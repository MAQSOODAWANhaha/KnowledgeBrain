{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledgebrain:bid:content-generation-output:v1",
  "title": "ContentGenerationOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operations", "factual_claims", "notices"],
  "properties": {
    "schema_version": { "const": 1 },
    "operations": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/operation" } },
    "factual_claims": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/claim" } },
    "notices": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/notice" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "clientRef": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "operation": { "type": "object", "additionalProperties": false, "required": ["kind", "client_operation_ref", "target_node_lineage_id", "ordinal", "block"], "properties": { "kind": { "const": "insert_block" }, "client_operation_ref": { "$ref": "#/$defs/clientRef" }, "target_node_lineage_id": { "$ref": "#/$defs/uuid" }, "ordinal": { "type": "integer", "minimum": 0 }, "block": { "$ref": "urn:knowledgebrain:bid:content-block:v1" } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["client_operation_ref", "utf8_start", "utf8_end", "evidence_bundle_id", "evidence_item_id"], "properties": { "client_operation_ref": { "$ref": "#/$defs/clientRef" }, "utf8_start": { "type": "integer", "minimum": 0 }, "utf8_end": { "type": "integer", "minimum": 1 }, "evidence_bundle_id": { "$ref": "#/$defs/uuid" }, "evidence_item_id": { "$ref": "#/$defs/uuid" } } },
    "notice": { "type": "object", "additionalProperties": false, "required": ["code", "severity", "message", "requirement_revision_id"], "properties": { "code": { "enum": ["NO_EVIDENCE", "WEAK_EVIDENCE", "UNSUPPORTED_FACT", "FORM_CONSTRAINT", "TARGET_ALREADY_HAS_CONTENT"] }, "severity": { "enum": ["info", "warning"] }, "message": { "type": "string", "minLength": 1, "maxLength": 4096 }, "requirement_revision_id": { "$ref": "#/$defs/uuid" } } }
  }
}
