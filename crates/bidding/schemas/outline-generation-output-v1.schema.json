{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledgebrain:bid:outline-generation-output:v1",
  "title": "OutlineGenerationOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "bindings", "notices"],
  "properties": {
    "schema_version": { "const": 1 },
    "nodes": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/node" } },
    "bindings": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/binding" } },
    "notices": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/notice" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "clientRef": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "node": { "type": "object", "additionalProperties": false, "required": ["client_node_ref", "parent_client_node_ref", "ordinal", "title", "semantic_role", "render_role", "origin_source_unit_revision_ids"], "properties": { "client_node_ref": { "$ref": "#/$defs/clientRef" }, "parent_client_node_ref": { "anyOf": [{ "$ref": "#/$defs/clientRef" }, { "type": "null" }] }, "ordinal": { "type": "integer", "minimum": 0 }, "title": { "type": "string", "minLength": 1, "maxLength": 1024 }, "semantic_role": { "enum": ["cover", "toc", "qualification", "technical", "commercial", "quotation", "deviation", "implementation", "evidence_index", "attachment", "other"] }, "render_role": { "enum": ["section", "front_matter", "toc", "appendix", "hidden"] }, "origin_source_unit_revision_ids": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } } } },
    "binding": { "type": "object", "additionalProperties": false, "required": ["need_occurrence_id", "channel", "target_client_node_ref"], "properties": { "need_occurrence_id": { "$ref": "#/$defs/uuid" }, "channel": { "enum": ["narrative_content", "response_table", "deviation_statement", "structured_form", "evidence_attachment", "quotation"] }, "target_client_node_ref": { "$ref": "#/$defs/clientRef" } } },
    "notice": { "type": "object", "additionalProperties": false, "required": ["code", "severity", "message", "source_identity"], "properties": { "code": { "enum": ["UNMAPPED_REQUIREMENT", "CONFLICTING_STRUCTURE", "LOW_CONFIDENCE", "UNRESOLVED_SOURCE", "FORM_STRUCTURE_DEVIATION"] }, "severity": { "enum": ["info", "warning", "high"] }, "message": { "type": "string", "minLength": 1, "maxLength": 4096 }, "source_identity": { "type": "string", "minLength": 1, "maxLength": 256 } } }
  }
}
