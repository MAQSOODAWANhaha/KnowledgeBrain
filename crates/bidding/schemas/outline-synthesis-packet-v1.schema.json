{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledgebrain:bid:outline-synthesis-packet:v1",
  "title": "OutlineSynthesisPacketV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_artifact_id", "frozen_input_sha256", "reduce_plan_sha256", "map_evidence_set_sha256", "manifest", "structure_fragments", "priority_reads", "requirement_routes", "conflicts", "notices", "selected_evidence", "selected_facts", "draft"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_artifact_id": { "$ref": "#/$defs/uuid" },
    "frozen_input_sha256": { "$ref": "#/$defs/sha256" },
    "reduce_plan_sha256": { "$ref": "#/$defs/sha256" },
    "map_evidence_set_sha256": { "$ref": "#/$defs/sha256" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "structure_fragments": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/fragment" } },
    "priority_reads": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
    "requirement_routes": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/route" } },
    "conflicts": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/conflict" } },
    "notices": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/packetNotice" } },
    "selected_evidence": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/evidenceRef" } },
    "selected_facts": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/fact" } },
    "draft": { "$ref": "#/$defs/draft" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": ["need_occurrence_id", "channel", "requiredness"],
      "properties": {
        "need_occurrence_id": { "$ref": "#/$defs/uuid" },
        "channel": { "enum": ["narrative_content", "response_table", "deviation_statement", "structured_form", "evidence_attachment", "quotation"] },
        "requiredness": { "enum": ["mandatory", "optional", "informational"] }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_unit_revision_ids", "requirement_occurrences", "structured_form_revision_ids", "batch_count"],
      "properties": {
        "source_unit_revision_ids": { "type": "array", "maxItems": 1000000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "requirement_occurrences": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/need" } },
        "structured_form_revision_ids": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "batch_count": { "type": "integer", "minimum": 1 }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_ref", "title", "semantic_role", "path_segments", "heading_level", "numbering", "source_order", "source_unit_revision_ids", "confidence"],
      "properties": {
        "signal_ref": { "$ref": "#/$defs/sha256" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "semantic_role": { "enum": ["cover", "toc", "qualification", "technical", "commercial", "quotation", "deviation", "implementation", "evidence_index", "attachment", "other"] },
        "path_segments": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "heading_level": { "type": "integer", "minimum": 0, "maximum": 32 },
        "numbering": { "type": ["string", "null"], "maxLength": 128 },
        "source_order": { "type": "integer", "minimum": 0 },
        "source_unit_revision_ids": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["need_occurrence_id", "suggested_semantic_role", "target_path_hint", "channel", "source_unit_revision_ids", "confidence"],
      "properties": {
        "need_occurrence_id": { "$ref": "#/$defs/uuid" },
        "suggested_semantic_role": { "enum": ["cover", "toc", "qualification", "technical", "commercial", "quotation", "deviation", "implementation", "evidence_index", "attachment", "other"] },
        "target_path_hint": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "channel": { "enum": ["narrative_content", "response_table", "deviation_statement", "structured_form", "evidence_attachment", "quotation"] },
        "source_unit_revision_ids": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_unit_revision_id", "offset", "length", "result_sha256"],
      "properties": {
        "source_unit_revision_id": { "$ref": "#/$defs/uuid" },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 },
        "result_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "source_unit_revision_ids"],
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_unit_revision_ids": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "packetNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "source_identity"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_identity": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "source_unit_revision_ids"],
      "properties": {
        "fact": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "source_unit_revision_ids": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "nodeIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_node_ref", "parent_client_node_ref", "title", "semantic_role"],
      "properties": {
        "client_node_ref": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
        "parent_client_node_ref": { "anyOf": [{ "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }, { "type": "null" }] },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "semantic_role": { "enum": ["cover", "toc", "qualification", "technical", "commercial", "quotation", "deviation", "implementation", "evidence_index", "attachment", "other"] }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "node_chunk_count", "route_chunk_count", "node_index", "routed_need_occurrence_ids"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" },
        "node_chunk_count": { "type": "integer", "minimum": 0 },
        "route_chunk_count": { "type": "integer", "minimum": 0 },
        "node_index": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/nodeIndex" } },
        "routed_need_occurrence_ids": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    }
  }
}
