{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledgebrain:bid:outline-synthesis-checkpoint:v1",
  "title": "OutlineSynthesisCheckpointV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt", "phase", "reduce_plan_sha256", "selected_evidence", "selected_facts", "accepted_node_chunks", "accepted_routes", "unresolved_need_occurrence_ids", "total_turns", "total_tool_calls", "text_bytes_read", "images_read"],
  "properties": {
    "schema_version": { "const": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["collecting", "drafting", "routing", "verifying", "repairing"] },
    "reduce_plan_sha256": { "$ref": "#/$defs/sha256" },
    "selected_evidence": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/evidenceRef" } },
    "selected_facts": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/fact" } },
    "accepted_node_chunks": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/nodeChunk" } },
    "accepted_routes": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/routeChunk" } },
    "unresolved_need_occurrence_ids": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
    "total_turns": { "type": "integer", "minimum": 0 },
    "total_tool_calls": { "type": "integer", "minimum": 0 },
    "text_bytes_read": { "type": "integer", "minimum": 0 },
    "images_read": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "clientRef": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_unit_revision_id", "offset", "length", "result_sha256"],
      "properties": {
        "source_unit_revision_id": { "$ref": "#/$defs/uuid" },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 },
        "result_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "source_unit_revision_ids"],
      "properties": {
        "fact": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "source_unit_revision_ids": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_node_ref", "parent_client_node_ref", "ordinal", "title", "semantic_role", "render_role", "origin_source_unit_revision_ids"],
      "properties": {
        "client_node_ref": { "$ref": "#/$defs/clientRef" },
        "parent_client_node_ref": { "anyOf": [{ "$ref": "#/$defs/clientRef" }, { "type": "null" }] },
        "ordinal": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "semantic_role": { "enum": ["cover", "toc", "qualification", "technical", "commercial", "quotation", "deviation", "implementation", "evidence_index", "attachment", "other"] },
        "render_role": { "enum": ["section", "front_matter", "toc", "appendix", "hidden"] },
        "origin_source_unit_revision_ids": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["need_occurrence_id", "channel", "target_client_node_ref"],
      "properties": {
        "need_occurrence_id": { "$ref": "#/$defs/uuid" },
        "channel": { "enum": ["narrative_content", "response_table", "deviation_statement", "structured_form", "evidence_attachment", "quotation"] },
        "target_client_node_ref": { "$ref": "#/$defs/clientRef" }
      }
    },
    "nodeChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_ref", "digest", "nodes"],
      "properties": {
        "chunk_ref": { "$ref": "#/$defs/clientRef" },
        "digest": { "$ref": "#/$defs/sha256" },
        "nodes": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/node" } }
      }
    },
    "routeChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_ref", "digest", "routes"],
      "properties": {
        "chunk_ref": { "$ref": "#/$defs/clientRef" },
        "digest": { "$ref": "#/$defs/sha256" },
        "routes": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/route" } }
      }
    }
  }
}
