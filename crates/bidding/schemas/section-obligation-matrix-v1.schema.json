{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledgebrain:bid:section-obligation-matrix:v1",
  "title": "SectionObligationMatrixV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sections"],
  "properties": {
    "schema_version": { "const": 1 },
    "sections": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/sectionObligations" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "channel": { "enum": ["narrative_content", "response_table", "deviation_statement", "structured_form", "evidence_attachment", "quotation"] },
    "semanticRole": { "enum": ["qualification", "technical", "commercial", "quotation", "deviation", "implementation", "evidence_index", "attachment", "other"] },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "title", "semantic_role", "ordinal", "requiredness", "evidence_kind", "source_unit_revision_ids", "structured_form_revision_ids", "need_occurrence_ids", "allowed_channels"],
      "properties": {
        "obligation_id": { "$ref": "#/$defs/sha256" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "semantic_role": { "$ref": "#/$defs/semanticRole" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "requiredness": { "enum": ["mandatory", "optional", "informational"] },
        "evidence_kind": { "enum": ["composition_member", "format_template", "structured_form", "mandatory_requirement", "technical_structure", "applicability_exclusion"] },
        "source_unit_revision_ids": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "structured_form_revision_ids": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "need_occurrence_ids": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "allowed_channels": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/channel" } }
      }
    },
    "sectionObligations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_ref", "required_children", "conditional_children", "excluded_children"],
      "properties": {
        "section_ref": { "$ref": "#/$defs/sha256" },
        "required_children": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/obligation" } },
        "conditional_children": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/obligation" } },
        "excluded_children": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/obligation" } }
      }
    }
  }
}
