{
  "name": "knowledgebrain-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vite-node src/bid/authoring/runTests.ts",
    "test:e2e": "npm run build && playwright test -c playwright.config.ts",
    "test:e2e:live": "npm run build && playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@stylexjs/stylex": "^0.19.2",
    "docx-preview": "^0.3.7",
    "lucide-react": "^1.73.0",
    "pdfjs-dist": "^4.10.38",
    "pptx-preview": "^1.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "pptx-preview": {
      "echarts": "^6.1.0",
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
