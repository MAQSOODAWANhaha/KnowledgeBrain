# Rust runtime and one-shot binaries. Build from the repository root:
#   docker build -f deploy/Dockerfile.rust --build-arg BIN=api -t knowledgebrain-api .
ARG RUST_IMAGE=rust:1.97-bookworm
FROM node:22-bookworm-slim AS web-builder
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM ${RUST_IMAGE} AS builder
WORKDIR /src
COPY rust-toolchain.toml rustfmt.toml Cargo.toml Cargo.lock ./
COPY crates crates
COPY migrations migrations
COPY services/docreader/proto services/docreader/proto
RUN mkdir -p deploy/first-launch
COPY deploy/queue-registry.toml deploy/queue-registry.toml
COPY deploy/first-launch/intended-state.toml deploy/first-launch/intended-state.toml
COPY deploy/first-launch/catalog-row-allowlist.toml deploy/first-launch/catalog-row-allowlist.toml
COPY deploy/first-launch/migration-manifest.toml deploy/first-launch/migration-manifest.toml
RUN cargo build --release -p api -p worker -p retention -p migrator -p first-launch-verifier

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*
ARG BIN=api
COPY --from=builder /src/target/release/api /usr/local/bin/api
COPY --from=builder /src/target/release/worker /usr/local/bin/worker
COPY --from=builder /src/target/release/retention /usr/local/bin/retention
COPY --from=builder /src/target/release/migrator /usr/local/bin/migrator
COPY --from=builder /src/target/release/first-launch-verifier /usr/local/bin/first-launch-verifier
COPY --from=web-builder /src/web/dist /web
ENV BIN=${BIN}
EXPOSE 8080
ENTRYPOINT ["/bin/sh", "-c", "exec \"$BIN\""]
