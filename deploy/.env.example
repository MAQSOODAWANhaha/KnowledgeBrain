# Fresh local deployment. Replace every required placeholder before starting.
# Secrets are exact bytes: quote values containing $, #, spaces, or shell syntax.
# Never commit deploy/.env. Engine admin is internal; this is the sole app DB login.
POSTGRES_USER=<application-database-username>
POSTGRES_PASSWORD='<application-database-password>'
KB_ADMIN_USERNAME=<application-login-name>
KB_ADMIN_PASSWORD='<application-login-password>'
JWT_SECRET='<independent-strong-jwt-secret>'
MINIO_ROOT_USER=<object-storage-username>
MINIO_ROOT_PASSWORD='<object-storage-password>'

# User-selected provider; no default vendor and no automatic model requests.
KNOWLEDGEBRAIN_CHAT_BASE_URL=<openai-compatible-base-url>
KNOWLEDGEBRAIN_CHAT_API_KEY='<model-api-key>'
KNOWLEDGEBRAIN_CHAT_MODEL=gpt-6-luna
KNOWLEDGEBRAIN_CHAT_MAX_CONTEXT_TOKENS=131072
# Unknown models: set true ONLY after verifying image + tool capabilities.
# Independent OCR does not give the Chat model image capability.
# KNOWLEDGEBRAIN_CHAT_SUPPORTS_IMAGES=true

# Optional independent OCR. All empty => inherit a confirmed image-capable Chat.
# A different endpoint requires its own key; Chat secrets are never sent there.
# KNOWLEDGEBRAIN_VLM_BASE_URL=<independent-ocr-base-url>
# KNOWLEDGEBRAIN_VLM_API_KEY='<independent-ocr-key>'
# KNOWLEDGEBRAIN_VLM_MODEL=<image-capable-model>

# Optional limits. No tokenizer calibration or limits JSON is required.
# KB_AUTHORING_TIMEOUT_MS=180000
# KB_AUTHORING_OUTPUT_TOKEN_RESERVE=16384
# KB_TENDER_PARSE_CONCURRENCY=4
# KNOWLEDGEBRAIN_CHAT_REASONING_EFFORT=<provider-supported-value>

# Internal topology defaults (containers only). Values are passed independently;
# Rust safely assembles the database URL, including reserved password characters.
# POSTGRES_DB=knowledgebrain
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# REDIS_URL=redis://redis:6379
# DOCREADER_ADDR=docreader:50051
# OBJECT_DIR=/data/objects
# KNOWLEDGEBRAIN_S3_ENDPOINT=http://minio:9000
# KNOWLEDGEBRAIN_S3_BUCKET=knowledgebrain
# KNOWLEDGEBRAIN_S3_REGION=us-east-1
# External S3 requires its own complete pair (never inherits MinIO credentials).
# KNOWLEDGEBRAIN_S3_ACCESS_KEY=<external-s3-access-key>
# KNOWLEDGEBRAIN_S3_SECRET_KEY='<external-s3-secret-key>'

# Local browser port; internal port and healthcheck change together.
# API_HOST_PORT=28080
# API_PORT=8080
# DOCREADER_GRPC_PORT=50051
# DOCREADER_GRPC_MAX_WORKERS=4
# DOCREADER_GRPC_MAX_FILE_SIZE_MB=50
# DOCREADER_PDF_RENDER_DPI=200
# DOCREADER_PDF_JPEG_QUALITY=85
# DOCREADER_PDF_RENDER_MAX_EDGE=2000
# GRPC_AUTH_TOKEN='<optional-shared-docreader-token>'

# LDAP replaces local password authentication; do not set unless using it.
# KNOWLEDGEBRAIN_LDAP_URL=<ldap-url>
# KNOWLEDGEBRAIN_LDAP_BIND_DN=<user-dn-template-containing-{user}>

# Knowledge functionality is off for tender-only deployment. Enabling it requires
# real embedding configuration; do not use stub endpoints to pass readiness.
# KNOWLEDGEBRAIN_KNOWLEDGE_ENABLED=true
# KNOWLEDGEBRAIN_EMBEDDING_BASE_URL=<embedding-base-url>
# KNOWLEDGEBRAIN_EMBEDDING_API_KEY='<embedding-api-key>'
# KNOWLEDGEBRAIN_EMBEDDING_MODEL=<embedding-model>

# Production release identity is provided by knowledgebrain-release, not copied
# from the synthetic development descriptor. See deploy/README.md.
