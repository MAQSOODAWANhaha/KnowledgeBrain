# Copy to deploy/.env and adjust. `deploy/deploy.sh` and
# `docker compose --env-file deploy/.env` both read this file.
# Keep ONLYOFFICE keys in the same block as docker-compose `x-app-env`.

# Development-only descriptor seam. Production release must override this file,
# descriptor hash, component digests, and images with externally inspected RepoDigests.
KB_RELEASE_DESCRIPTOR_FILE=./release-descriptor-v1.development.json
KB_RELEASE_DESCRIPTOR_SHA256=770ce81ba32a38ff76cdee4e26abe276e3645a07dd6a6bf9d14ebf2bee76d84c
KB_DEPLOYMENT_NAMESPACE_ID=00000000-0000-4000-8000-000000000001

# --- host publish ports ---
# Local Compose (`deploy.sh` + docker-compose.local.yml): Caddy terminates TLS.
# Browser: https://127.0.0.1:${API_HOST_PORT}/ and https://<LAN-IP>:${API_HOST_PORT}/
# API container still listens HTTP :8080 (healthchecks, ONLYOFFICE callbacks).
# Document Server browser origin is https://<same-host>:${ONLYOFFICE_HOST_PORT}/
# Command/callback inside Docker stay http://onlyoffice/ and http://api:8080/.
# Production compose without local.yml still publishes API HTTP on API_HOST_PORT.
API_HOST_PORT=18080
ONLYOFFICE_HOST_PORT=18081
DOCREADER_HOST_PORT=15051
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_HOST_PORT=19000
MINIO_CONSOLE_PORT=19001
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687

# --- data plane ---
POSTGRES_USER=knowledgebrain
POSTGRES_PASSWORD=knowledgebrain
POSTGRES_DB=knowledgebrain
# Explicit fresh-schema bootstrap and distinct least-privilege runtime identities.
KNOWLEDGEBRAIN_MIGRATOR_PASSWORD=migrator-change-me
KNOWLEDGEBRAIN_API_DB_PASSWORD=api-change-me
KNOWLEDGEBRAIN_WORKER_DB_PASSWORD=worker-change-me
KNOWLEDGEBRAIN_RETENTION_DB_PASSWORD=retention-change-me
REDIS_URL=redis://redis:6379

# --- objects ---
OBJECT_DIR=/data/objects
KNOWLEDGEBRAIN_S3_BUCKET=knowledgebrain
KNOWLEDGEBRAIN_S3_ENDPOINT=http://minio:9000
KNOWLEDGEBRAIN_S3_ACCESS_KEY=minioadmin
KNOWLEDGEBRAIN_S3_SECRET_KEY=minioadmin
KNOWLEDGEBRAIN_S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- process ---
# api/worker tracing. Default info. Use bid=debug for per-family extract agents.
RUST_LOG=info
# Optional. Empty = detect from document text (zh vs en). Do not hardcode in product code.
# KNOWLEDGEBRAIN_CONTENT_LANGUAGE=zh
NO_COLOR=1
JWT_SECRET=change-me
# Local Compose Document Server. Must be set; editor fails closed if incomplete.
# JWT secret must differ from capability secret and from JWT_SECRET.
KB_ONLYOFFICE_SERVER_ORIGIN=https://127.0.0.1:18081/
KB_ONLYOFFICE_COMMAND_ORIGIN=http://onlyoffice/
KB_ONLYOFFICE_API_ORIGIN=http://api:8080/
KB_ONLYOFFICE_JWT_SECRET=onlyoffice-jwt-change-me
KB_ONLYOFFICE_CAPABILITY_SECRET=onlyoffice-capability-change-me
KB_ONLYOFFICE_TOKEN_TTL_SECONDS=1200
KB_ONLYOFFICE_HTTP_TIMEOUT_SECONDS=120
KNOWLEDGEBRAIN_BOOTSTRAP_KEY=
# LDAP login. Empty = test/local: any/empty email+password is accepted (user created). Register stays closed.
KNOWLEDGEBRAIN_LDAP_URL=
KNOWLEDGEBRAIN_LDAP_BIND_DN=uid={user},ou=people,dc=example,dc=com
# Tender extraction: hybrid (default fallback), agent (strict), heuristic (no LLM).
# Empty falls back to KNOWLEDGEBRAIN_CHAT_MODEL.
API_PORT=8080
# built SPA (npm -C web run build). empty = API only
KNOWLEDGEBRAIN_WEB_ROOT=
DOCREADER_ADDR=docreader:50051
DOCREADER_GRPC_PORT=50051
# Required before starting tender-analysis requests; JSON budget contract.
# Keys and source-view sizing: docs/bidding/outline.md.
# The configured chat model must support function tools and image input.
# Basic provider configuration is sufficient for verified model/tokenizer pairs.
# Effective max_context_tokens defaults to 131072 (application request allowance,
# including history, tools, images and output; not discovered provider capacity).
# Custom models require measured calibration, with no duplicated model_id:
# KB_AUTHORING_TOKENIZER_PROFILE='{"encoding":"o200k_base","calibration":{"multiplier_bps":11500,"provenance":"REPLACE_WITH_ACTUAL_MEASUREMENT"}}'
# Optional overrides merge into defaults; no mandatory complete limits JSON.
# Declare vision only after verifying this same model's image_url capability:
# KB_TENDER_AGENT_LIMITS='{"vision_enabled":true}'
# Unknown fields, removed byte caps and cumulative quotas are rejected.
# Effective settings are frozen; changed settings require a new run.
# optional Neo4j dual-write (empty = Postgres only)
KNOWLEDGEBRAIN_NEO4J_HTTP_URL=
KNOWLEDGEBRAIN_NEO4J_USERNAME=
KNOWLEDGEBRAIN_NEO4J_PASSWORD=
NEO4J_AUTH=

# optional embedding HTTP. Aliases: EMBEDDING_*.
# Embedding requests send dimensions=1024 (pgvector column / 0008), not 1536.
KNOWLEDGEBRAIN_EMBEDDING_BASE_URL=
KNOWLEDGEBRAIN_EMBEDDING_API_KEY=
KNOWLEDGEBRAIN_EMBEDDING_MODEL=stub-emb
# Required at api/worker startup. OpenAI Chat Completions only (/v1/chat/completions).
# Aliases: LLM_BASE_URL / LLM_API_KEY / LLM_MODEL. stub-chat is rejected.
KNOWLEDGEBRAIN_CHAT_BASE_URL=
KNOWLEDGEBRAIN_CHAT_API_KEY=
KNOWLEDGEBRAIN_CHAT_MODEL=
# Positive integer defaults for new bidding requests; runtime reads and freezes them.
KB_AUTHORING_MAX_OUTPUT_TOKENS=8192
KB_AUTHORING_TIMEOUT_MS=180000
# Optional provider-supported value. Empty omits the parameter; no model-name inference.
KNOWLEDGEBRAIN_CHAT_REASONING_EFFORT=
KNOWLEDGEBRAIN_VLM_BASE_URL=
KNOWLEDGEBRAIN_VLM_API_KEY=
KNOWLEDGEBRAIN_VLM_MODEL=
KNOWLEDGEBRAIN_MINERU_ENDPOINT=
KNOWLEDGEBRAIN_PADDLE_ENDPOINT=

# runtime concurrency (0 / unset = spec defaults)
KNOWLEDGEBRAIN_CORE_CONCURRENCY=8
KNOWLEDGEBRAIN_POSTPROCESS_CONCURRENCY=2
KNOWLEDGEBRAIN_ENRICHMENT_CONCURRENCY=12
KNOWLEDGEBRAIN_MAINTENANCE_CONCURRENCY=4
KNOWLEDGEBRAIN_SHARED_CONCURRENCY=6
KNOWLEDGEBRAIN_WIKI_CONCURRENCY=8
